{
  "name": "acb-web",
  "version": "0.1.0",
  "type": "module",
  "description": "AI Code Battle web frontend - deployed via Argo Workflows to Cloudflare Pages",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit",
    "build": "tsc && vite build",
    "build-with-timeout": "timeout 60s tsc && timeout 120s vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "agentation": "^3.0.2",
    "jsdom": "^25.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^3.0.5"
  }
}
