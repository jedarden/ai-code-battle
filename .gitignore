# Binaries (root-level only)
/acb-*
/arena.test
!/*.md

# Node modules
node_modules/

# Build outputs
dist/
*.js.map

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test outputs
replay.json
test-replays/
test-replay*.json
match-*.log

# Generated map data
web/public/data/maps/

# Marathon instructions (local only)
.marathon/

# Development tools
# Bead store: SQLite and history stay local; the JSONL checkpoint is tracked.
# Must be `.beads/*`, not `.beads/` — git cannot re-include a file whose
# parent directory is excluded.
.beads/*
!.beads/issues.jsonl
.needle.yaml

# Rust build artifacts
target/

# Python bytecode cache
__pycache__/

# wasm bot build outputs
wasm/bots/*/build/
