# Binaries (root-level only)
/acb-*
/arena.test
!/*.md

# Node modules
node_modules/

# Build outputs
dist/
*.js.map

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test outputs
replay.json
test-replays/
test-replay*.json
match-*.log

# Generated map data
web/public/data/maps/

# Marathon instructions (local only)
.marathon/

# Development tools
# Bead store: SQLite and history stay local; the JSONL checkpoint is tracked.
# Must be `.beads/*`, not `.beads/` — git cannot re-include a file whose
# parent directory is excluded.
.beads/*
!.beads/issues.jsonl
# .needle.yaml carries the per-workspace bead backend binding, which NEEDLE
# requires to be committed so every host resolves the same store.
#.needle.yaml

# Rust build artifacts
target/

# Python bytecode cache
__pycache__/

# wasm bot build outputs
wasm/bots/*/build/

# bead-rs store: the durable artefact is the checkpoint plus config.json.
!.beads/checkpoint/
!.beads/checkpoint/**
!.beads/config.json

# Worker execution traces can contain raw tool output (credentials) — never commit (see 2026-07-25 GH_TOKEN leak, 2026-08-22 CF token leak)
.beads/traces/
