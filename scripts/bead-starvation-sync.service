[Unit]
Description=Automated bead store checkpoint sync
After=network.target

[Service]
Type=oneshot
User=coding
WorkingDirectory=/home/coding/ai-code-battle
ExecStart=/home/coding/ai-code-battle/scripts/bead-starvation-sync.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
